# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
!.env.example

# Runtime data-store (JSON files written by admin) — data lives in Vercel Blob on prod
# Ignore runtime-written data files but keep option definitions (static config with descriptions/images)
# Runtime data-store. Customer data NEVER enters git — orders, bespoke-orders
# and consultations hold names, emails, phone numbers and delivery addresses.
/data-store/orders.json
/data-store/bespoke-orders.json
/data-store/consultations.json
/data-store/image-review-*.json
/data-store/image-rejections.json
/data-store/blueprint-repoint.json

# Site CONFIGURATION is tracked on purpose. The Blob store is suspended
# (Hobby transfer allowance exhausted), and loadDataAsync falls back to these
# committed files, so tracking them is what lets the local admin edit -> commit
# -> push -> deploy loop work with no Blob at all. They contain no customer data.
!/data-store/fabrics.json
!/data-store/fabric-book.json
!/data-store/site-settings.json
!/data-store/content.json
!/data-store/products.json
!/data-store/collections.json
!/data-store/accessories.json
!/data-store/theme.json

# vercel
.vercel

# Factory scraping reference images — dev-only, not served in the app
/public/images/factory/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Catalog safety snapshots taken before batch operations
/data-store/options.backup-*

# Local archive of superseded working files (never track)
_archive/

# Live supplier-portal capture: session-bearing DOM dumps and probe output.
# Tools are tracked; raw captures are not.
factory-screenshots/baoxiniao-capture/

# Supplier drawing captures — large, dev-only reference sets (like factory-screenshots)
factory-screenshots/baoxiniao/
